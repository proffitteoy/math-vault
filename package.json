{
  "name": "personal-blog",
  "description": "Personal website for projects, notes, music, and long-form knowledge",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "author": "proffitteoy",
  "license": "GPL-3.0-only",
  "homepage": "https://nothing-new.icu",
  "repository": {
    "type": "git",
    "url": "https://github.com/proffitteoy/math-vault.git"
  },
  "scripts": {
    "notes:build": "node quartz/bootstrap-cli.mjs build -o .quartz-cache/quartz-site",
    "dev": "npm run notes:build && next dev",
    "build": "npm run notes:build && next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "sync:obsidian": "node scripts/obsidian-sync.mjs",
    "sync:obsidian:check": "node scripts/obsidian-sync.mjs --check",
    "sync:obsidian:dry": "node scripts/obsidian-sync.mjs --dry-run",
    "sync:obsidian:init": "node scripts/obsidian-sync.mjs --init-from-content",
    "sync:obsidian:review": "node scripts/obsidian-sync.mjs --review",
    "sync:obsidian:review:all": "node scripts/obsidian-sync.mjs --review --all",
    "check": "tsc --noEmit && npx prettier . --check",
    "format": "npx prettier . --write",
    "test": "tsx --test"
  },
  "engines": {
    "node": "22.x",
    "npm": ">=10.9.2"
  },
  "keywords": [
    "site generator",
    "ssg",
    "digital-garden",
    "markdown",
    "blog"
  ],
  "dependencies": {
    "@napi-rs/simple-git": "1.1.0",
    "ansi-truncate": "^1.4.0",
    "esbuild-sass-plugin": "^3.7.0",
    "flexsearch": "^0.8.212",
    "framer-motion": "^13.1.1",
    "github-slugger": "^2.0.0",
    "globby": "^16.2.4",
    "gray-matter": "^4.0.3",
    "hast-util-to-html": "^9.0.5",
    "hast-util-to-string": "^3.0.1",
    "highlight.js": "^11.12.0",
    "is-absolute-url": "^5.0.0",
    "js-yaml": "^5.4.1",
    "katex": "^0.18.4",
    "lightningcss": "^1.33.0",
    "lucide-react": "^1.37.0",
    "mdast-util-find-and-replace": "^3.0.2",
    "mdast-util-to-hast": "^13.2.1",
    "mdast-util-to-string": "^4.0.0",
    "minimatch": "^10.2.6",
    "next": "16.3.3",
    "preact": "^10.29.8",
    "pretty-time": "^1.1.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-highlight": "^7.0.2",
    "rehype-katex": "^7.0.1",
    "rehype-pretty-code": "^0.14.5",
    "rehype-raw": "^7.0.0",
    "rehype-slug": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-frontmatter": "^5.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "remark-smartypants": "^3.0.3",
    "rfdc": "^1.4.1",
    "shiki": "^4.4.3",
    "source-map-support": "^0.5.21",
    "three": "^0.185.1",
    "to-vfile": "^8.0.0",
    "toml": "^5.0.0",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.1.0",
    "vfile": "^6.0.3",
    "workerpool": "^10.0.3",
    "yargs": "^18.1.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/hast": "^3.0.4",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^26",
    "@types/pretty-time": "^1.1.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/source-map-support": "^0.5.10",
    "@types/three": "^0.185.4",
    "esbuild": "^0.27.0",
    "eslint": "^10",
    "eslint-config-next": "16.3.3",
    "prettier": "^3.9.6",
    "tailwindcss": "^4",
    "tsx": "^4.23.13",
    "typescript": "^7"
  }
}
